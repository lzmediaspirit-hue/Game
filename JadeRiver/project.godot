config_version=5
[application]
config/name="Jade River — Wuxia Engine"
run/main_scene="res://scenes/pixel_stage.tscn"
config/icon="res://art/icon.png"
config/features=PackedStringArray("4.5", "GL Compatibility")
[autoload]
ContentDB="*res://scripts/core/content_db.gd"
GameEvents="*res://scripts/core/game_events.gd"
Clock="*res://scripts/core/clock_service.gd"
Rng="*res://scripts/core/rng_service.gd"
Unlocks="*res://scripts/core/unlock_service.gd"
Saves="*res://scripts/core/save_service.gd"
Game="*res://scripts/simulation/authority/game_authority.gd"
Audio="*res://scripts/audio/audio_director.gd"
Notifier="*res://scripts/shell/notifier.gd"
Wardrobe="*res://scripts/wardrobe.gd"
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0
[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
[input_devices]
pointing/emulate_touch_from_mouse=false



